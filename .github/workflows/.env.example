# Скопируйте файл в .env и заполните значения.

# --- LLM: любой сервер с OpenAI-совместимым API ---
# Вариант 1. Ollama — локально и бесплатно (https://ollama.com):
#   ollama pull qwen3.5:4b   (около 6 ГБ — помещается в видеокарту на 8 ГБ)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b

# Вариант 2. Облачный провайдер (OpenAI, OpenRouter и др.):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=название-модели-с-поддержкой-tool-calling

# --- Источник вакансий ---
# trudvsem — портал «Работа России», открытый API без ключа (по умолчанию)
# files    — папка с вакансиями, которые вы сохранили сами (.txt / .md)
# hh       — hh.ru; с апреля 2026 работает только с токеном приложения
VACANCY_SOURCE=trudvsem
VACANCIES_DIR=vacancies
# Код региона для «Работы России», например 7700000000000 — Москва (пусто — вся Россия)
# TRUDVSEM_REGION=

# --- hh.ru (только с токеном приложения из https://dev.hh.ru) ---
# HH_APP_TOKEN=
HH_USER_AGENT=job-agent/0.1 (your-email@example.com)
# 113 — вся Россия, 1 — Москва, 2 — Санкт-Петербург
HH_AREA=113

# --- Telegram (необязательно) ---
# Бот создаётся через @BotFather, chat_id можно узнать у @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

DB_PATH=data/job_agent.sqlite3
MAX_STEPS=25
